{
    "manifest_version": 3,
    "name": "PhishGuard AI",
    "version": "1.0.0",
    "description": "AI-powered phishing website detector using Hugging Face.",

    "permissions": [
        "activeTab",
        "storage",
        "tabs",
        "scripting"
    ],

    "host_permissions": [
        "<all_urls>",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*"
    ],

    "action": {
        "default_popup": "popup.html",
        "default_title": "PhishGuard AI"
    },

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}